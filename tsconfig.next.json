{
  // Used ONLY by `next build` (next.config.mjs typescript.tsconfigPath).
  // scripts/ carries accepted errors (imports the gitignored scripts/blend-utils),
  // which would fail the production build; `npx tsc --noEmit` on the root
  // tsconfig.json remains the full-repo typecheck.
  "extends": "./tsconfig.json",
  "include": [
    "next-env.d.ts",
    "src",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "scripts",
    "tests"
  ]
}
